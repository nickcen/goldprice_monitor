[Unit]
Description=Gold Price Monitor API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_PORT=18080
WorkingDirectory=/opt/goldprice-monitor
ExecStart=/usr/bin/java -jar /opt/goldprice-monitor/api.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
